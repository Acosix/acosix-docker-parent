<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.acosix.docker</groupId>
    <artifactId>acosix-docker-parent</artifactId>
    <packaging>pom</packaging>
    <version>1.1.0</version>

    <name>Acosix Docker Parent</name>
    <description>Parent POM for Acosix Maven-based Docker Builds</description>
    <url>https://github.com/Acosix/docker-parent</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:Acosix/docker-parent.git</connection>
        <developerConnection>scm:git:git@github.com:Acosix/docker-parent.git</developerConnection>
        <url>git@github.com:Acosix/docker-parent.git</url>
    </scm>

    <developers>
        <developer>
            <id>AFaust</id>
            <name>Axel Faust</name>
            <email>axel.faust@acosix.de</email>
            <organization>Acosix GmbH</organization>
            <roles>
                <role>Founder</role>
                <role>Architect</role>
                <role>Developer</role>
            </roles>
            <properties>
                <twitter>twitter.com/ReluctantBird83</twitter>
            </properties>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.enforcer.version>3.6.1</maven.enforcer.version>
        <maven.clean.version>3.5.0</maven.clean.version>
        <maven.resources.version>3.3.1</maven.resources.version>
        <maven.dependency.version>3.8.1</maven.dependency.version>
        <maven.toolchain.version>3.2.0</maven.toolchain.version>
        <maven.war.version>3.5.1</maven.war.version>
        <maven.antrun.version>3.2.0</maven.antrun.version>
        <maven.install.version>3.1.4</maven.install.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <maven.deploy.version>3.1.4</maven.deploy.version>
        <maven.helper.version>3.6.1</maven.helper.version>
        <maven.exec.version>3.5.1</maven.exec.version>

        <maven.sonatype.central.version>0.9.0</maven.sonatype.central.version>

        <docker.registry.push.prefix></docker.registry.push.prefix>
        <docker.registry.pull.prefix></docker.registry.pull.prefix>

        <docker.image.organisation>acosix</docker.image.organisation>
        <docker.image.name>${project.artifactId}</docker.image.name>
        <docker.image.id>${docker.image.organisation}/${docker.image.name}</docker.image.id>

        <docker.from.name></docker.from.name>
        <docker.from.organisation>${docker.image.organisation}</docker.from.organisation>
        <docker.from.id>${docker.from.organisation}/${docker.from.name}</docker.from.id>
        <docker.from.version>${project.version}</docker.from.version>

        <docker.labels.vendor>Acosix GmbH</docker.labels.vendor>
        <docker.labels.maintainer>info@acosix.org</docker.labels.maintainer>
        <docker.labels.namespace>de.acosix.docker</docker.labels.namespace>
    </properties>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>alfresco-public</id>
            <url>https://artifacts.alfresco.com/nexus/content/groups/public</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <distributionManagement>
        <repository>
            <id>central</id>
            <url>https://ossrh-staging-api.central.sonatype.com/service/local/staging/deploy/maven2/</url>
        </repository>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-maven</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>${maven.toolchain.version}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.version}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.version}</version>
                    <configuration>
                        <escapeString>\</escapeString>
                    </configuration>
                </plugin>

                <plugin>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven.dependency.version}</version>
                </plugin>

                <plugin>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${maven.war.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${maven.helper.version}</version>
                    <executions>
                        <execution>
                            <id>parse-project-version</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>parse-version</goal>
                            </goals>
                            <configuration>
                                <propertyPrefix>project.version</propertyPrefix>
                            </configuration>
                        </execution>
                        <execution>
                            <id>generate-docker-release-date</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>timestamp-property</goal>
                            </goals>
                            <configuration>
                                <name>docker.labels.release-date</name>
                                <pattern>yyyy-MM-dd</pattern>
                                <timeZone>UTC</timeZone>
                                <locale>en</locale>
                            </configuration>
                        </execution>
                        <execution>
                            <id>parse-image-from-version</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>parse-version</goal>
                            </goals>
                            <configuration>
                                <propertyPrefix>docker.from.version</propertyPrefix>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven.antrun.version}</version>
                    <executions>
                        <execution>
                            <id>fix-docker-resources-eol</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <fixcrlf srcDir="${project.build.directory}/ImageBuild" eol="unix"
                                        encoding="${project.build.sourceEncoding}" />
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${maven.exec.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <id>build-image</id>
                            <phase>package</phase>
                            <goals>
                                <goal>exec</goal>
                            </goals>
                            <configuration>
                                <executable>docker</executable>
                                <arguments>
                                    <argument>compose</argument>
                                    <argument>-f</argument>
                                    <argument>${project.build.directory}/ImageBuild/docker-compose.yaml</argument>
                                    <argument>build</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${maven.sonatype.central.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <deploymentName>central.sonatype.com</deploymentName>
                        <autoPublish>true</autoPublish>
                        <waitUntil>published</waitUntil>
                    </configuration>
                </plugin>

                <plugin>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven.gpg.version}</version>
                    <configuration>
                        <useAgent>false</useAgent>
                        <keyname>${gpg.keyname}</keyname>
                        <passphraseServerId>${gpg.keyname}</passphraseServerId>
                    </configuration>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>docker-build</id>
            <activation>
                <property>
                    <name>docker.skip</name>
                    <value>!true</value>
                </property>
                <file>
                    <exists>src/main/resources/docker-compose.yaml</exists>
                </file>
            </activation>

            <properties>
                <docker.latest.build.skip>false</docker.latest.build.skip>
                <docker.latest.push.skip>false</docker.latest.push.skip>
            </properties>

            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <targetPath>${project.build.directory}/ImageBuild</targetPath>
                        <filtering>true</filtering>
                    </resource>
                </resources>

                <pluginManagement>
                    <plugins>

                        <plugin>
                            <groupId>org.codehaus.mojo</groupId>
                            <artifactId>exec-maven-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>buildLatest</id>
                                    <phase>package</phase>
                                    <goals>
                                        <goal>exec</goal>
                                    </goals>
                                    <configuration>
                                        <skip>${docker.latest.build.skip}</skip>
                                        <executable>docker</executable>
                                        <arguments>
                                            <argument>compose</argument>
                                            <argument>-f</argument>
                                            <argument>${project.build.directory}/ImageBuild/docker-compose.yaml</argument>
                                            <argument>build</argument>
                                        </arguments>
                                    </configuration>
                                </execution>
                                <execution>
                                    <id>pushLatest</id>
                                    <phase>deploy</phase>
                                    <goals>
                                        <goal>exec</goal>
                                    </goals>
                                    <configuration>
                                        <skip>${docker.latest.push.skip}</skip>
                                        <executable>docker</executable>
                                        <arguments>
                                            <argument>compose</argument>
                                            <argument>-f</argument>
                                            <argument>${project.build.directory}/ImageBuild/docker-compose.yaml</argument>
                                            <argument>push</argument>
                                        </arguments>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>

                    </plugins>
                </pluginManagement>

                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                    </plugin>

                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>docker-tag</id>
            <activation>
                <property>
                    <name>docker.skip</name>
                    <value>!true</value>
                </property>
                <file>
                    <exists>src/main/resources/docker-compose-tags.yaml</exists>
                </file>
            </activation>

            <properties>
                <docker.tag.build.skip>false</docker.tag.build.skip>
                <docker.tag.push.skip>false</docker.tag.push.skip>
            </properties>

            <build>

                <pluginManagement>
                    <plugins>

                        <plugin>
                            <groupId>org.codehaus.mojo</groupId>
                            <artifactId>exec-maven-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>buildTags</id>
                                    <phase>package</phase>
                                    <goals>
                                        <goal>exec</goal>
                                    </goals>
                                    <configuration>
                                        <skip>${docker.tag.build.skip}</skip>
                                        <executable>docker</executable>
                                        <arguments>
                                            <argument>compose</argument>
                                            <argument>-f</argument>
                                            <argument>${project.build.directory}/ImageBuild/docker-compose-tags.yaml</argument>
                                            <argument>build</argument>
                                        </arguments>
                                    </configuration>
                                </execution>
                                <execution>
                                    <id>pushTags</id>
                                    <phase>deploy</phase>
                                    <goals>
                                        <goal>exec</goal>
                                    </goals>
                                    <configuration>
                                        <skip>${docker.tag.push.skip}</skip>
                                        <executable>docker</executable>
                                        <arguments>
                                            <argument>compose</argument>
                                            <argument>-f</argument>
                                            <argument>${project.build.directory}/ImageBuild/docker-compose-tags.yaml</argument>
                                            <argument>push</argument>
                                        </arguments>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>

                    </plugins>
                </pluginManagement>

                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                    </plugin>

                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>
</project>
